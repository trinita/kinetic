# WhatsApp number for enquiry links, wa.me format (country code, no +, spaces or dashes)
NEXT_PUBLIC_WHATSAPP_NUMBER=6281399325549

# Public URL of the site (used in links inside WhatsApp messages)
NEXT_PUBLIC_SITE_URL=https://kinetic.co

# Meaning-based search (optional). Without a key the site uses keyword search.
# Voyage AI key: https://dash.voyageai.com — then run `npm run search:index`.
# EMBEDDINGS_API_KEY=
# EMBEDDINGS_MODEL=voyage-3.5
# SEARCH_MIN_SIMILARITY=0.45

# Later phases
# ANTHROPIC_API_KEY=
